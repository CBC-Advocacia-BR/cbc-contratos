# ═══════════════════════════════════════════════════════════════════════════
# CBC Contratos — inventário de variáveis de ambiente
# (auditoria 01/08/2026 — item 167). Levantado do código em 03/08/2026.
# ═══════════════════════════════════════════════════════════════════════════
#
# Este arquivo NÃO guarda valores. Ele responde a três perguntas que antes só se
# descobriam quebrando algo: quais variáveis existem, para que servem, e o que para
# de funcionar sem cada uma.
#
# ONDE ELAS VIVEM DE VERDADE: no painel da Netlify (Site configuration > Environment
# variables), contexto "all". Não há `.env` em produção. Localmente, um `.env` dentro
# de `client/` cobre apenas as `VITE_*` — as demais só existem no runtime das functions.
#
# ANTES DESTE ARQUIVO ele listava só as chaves AWS do servidor Express, aposentado em
# 20/06/2026 — ou seja, documentava um sistema que não existe mais.
#
# ⚠️ Conferido no painel em 02/08/2026: **SUPABASE_URL não está cadastrada**. Os módulos
# sem fallback embutido morriam em silêncio por causa disso (o backup no Storage, o
# limitador compartilhado e o cache de notas do Kommo nunca funcionaram). Hoje o código
# tem fallback, mas cadastrar continua sendo o certo.


# ─── Banco de dados ────────────────────────────────────────────────────────
# Sem estas o aplicativo não abre. A chave anônima é pública por design: a proteção
# vem das políticas de RLS no banco, não do sigilo dela.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mesmas informações, lidas pelas Netlify Functions (o runtime delas não enxerga VITE_*).
# SUPABASE_URL: ⚠️ NÃO cadastrada hoje — há fallback no código, mas cadastre.
# SUPABASE_SERVICE_ROLE_KEY: ignora a RLS. Só para gravação server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que autoriza as RPCs de escrita (espelho Asaas, backup, bot_config).
# Sem ele essas funções respondem "acesso negado" e a sincronização congela.
BOT_RPC_SECRET=


# ─── Integrações ───────────────────────────────────────────────────────────
ADVBOX_TOKEN=                 # CRM jurídico: cliente, processo, tarefas, andamentos
ADVBOX_OPERACIONAL_USER_ID=   # responsável padrão das tarefas operacionais
ASAAS_API_KEY=                # cobrança (boleto/PIX/NF). Produção usa prefixo $aact_prod_
ASAAS_WEBHOOK_TOKEN=          # valida o webhook de pagamento
ZAPSIGN_TOKEN=                # assinatura eletrônica
ZAPSIGN_WEBHOOK_SECRET=       # ⚠️ sem ela o webhook é fail-open (mitigado por re-checagem na API)
KOMMO_TOKEN=                  # CRM comercial: mover lead, notas, bot de WhatsApp
KOMMO_DETRATOR_RESPONSAVEL=   # a quem atribuir um NPS detrator
META_ADS_TOKEN=               # Marketing API (token de system user, não expira)
META_AD_ACCOUNT_ID=           # conta de anúncio principal
META_AD_ACCOUNT_IDS=          # opcional: várias contas, separadas por vírgula
APPS_SCRIPT_URL=              # ⚠️ funciona como CHAVE: quem tem a URL escreve no Drive (item 38)
CPF_API_TOKEN=                # consulta de CPF (cpfcnpj.com.br)
ANTHROPIC_API_KEY=            # opcional: tradutor de andamentos por IA (hoje desligado)

# Agenda do Google (videochamadas do funil + auditoria de comparecimento no Meet).
# O refresh token já expirou uma vez (23/07/2026) e a agenda parou sem aviso — é uma das
# credenciais que o tokens-vigia-cron confere todo dia às 08h.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=


# ─── Avisos e portal ───────────────────────────────────────────────────────
# ⚠️ RESEND_API_KEY não está cadastrada: hoje todo alerta crítico (vigia de credenciais,
# verificação do backup, watchdog) só produz o sino dentro do app e nunca chega por
# e-mail. Decisão do Paulo em 02/08/2026: não quer aviso por e-mail. Mantida aqui para
# o dia em que mudar de ideia.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Notificações push do Portal do Cliente (web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

PORTAL_LINK_KEY=              # assina os links de acesso do portal
WEBHOOK_SECRET=               # valida webhooks externos genéricos


# ─── Painéis internos ──────────────────────────────────────────────────────
# O mesmo valor precisa estar nas duas: a de cima é lida pelas functions, a de baixo
# entra no bundle do navegador para o painel do bot conseguir chamar a API.
BOT_PANEL_KEY=
VITE_BOT_PANEL_KEY=

VITE_SENTRY_DSN=              # opcional: rastreamento de erro no navegador
VITE_APP_VERSION=             # opcional: sobrescreve a versão exibida no cabeçalho


# ─── Só para desenvolvimento ───────────────────────────────────────────────
# NETLIFY_AUTH_TOKEN não vai aqui: fica em ~/.cbc-netlify-token e o deploy.sh carrega.
#
# VITE_API_URL só existe como resquício do servidor Express aposentado. Deixe vazio —
# em produção o /api é servido pelas edge functions. Para rodar as functions na sua
# máquina, use `npx netlify dev` no lugar de `npm run dev`.
VITE_API_URL=


# ─── Cadastradas na Netlify mas SEM USO (conferido em 02/08/2026) ──────────
# REST_API_KEYS e POWERBI_API_KEY: os endpoints api-rest e api-powerbi tiveram ZERO
# chamadas em 7 dias. O Power BI lê as views direto no banco com o usuário powerbi_cbc.
# Sem essas chaves os endpoints se desativam sozinhos (503), que é o comportamento
# seguro. Não cadastre sem necessidade.
